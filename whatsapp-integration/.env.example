# ─── WhatsApp Cloud API credentials ───
# Get these from https://developers.facebook.com → Your App → WhatsApp → API Setup

# Temporary access token (valid ~24 hours, copy from API Setup page)
WHATSAPP_ACCESS_TOKEN=your_temporary_access_token_here

# Phone Number ID (shown below the access token on the API Setup page)
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here

# Graph API version (shown in the API Setup page, e.g. v21.0)
GRAPH_API_VERSION=v21.0

# ─── Webhook configuration ───
# You make up this secret string yourself — use the SAME value
# when registering the webhook in the Meta Developer dashboard
WEBHOOK_VERIFY_TOKEN=my_secret_verify_token_123

# ─── Signature verification ───
# App Secret (from Meta Developer dashboard → App Settings → Basic → App Secret)
META_APP_SECRET=your_app_secret_here

# ─── Twilio WhatsApp Trial / Sandbox (optional) ───
# Account SID and Auth Token from https://console.twilio.com (under Account Info)
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_auth_token_here

# Twilio WhatsApp sender from "Try out WhatsApp" page (e.g. whatsapp:+14155238886)
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Approved template ContentSid from Twilio Console → Messaging → Try it out → Send a WhatsApp message
# (or Messaging → Content Template Builder). Starts with HX...
TWILIO_CONTENT_SID=HXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Optional: JSON variables for template placeholders (e.g. {"1":"Smart Nagrik"})
TWILIO_CONTENT_VARIABLES={}
