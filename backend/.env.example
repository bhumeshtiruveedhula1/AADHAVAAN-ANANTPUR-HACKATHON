SMART_NAGRIK_HOST=127.0.0.1
SMART_NAGRIK_PORT=5000
SMART_NAGRIK_CORS_ORIGINS=
SMART_NAGRIK_LOG_LEVEL=INFO
TWILIO_ACCOUNT_SID=YOUR_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN
TWILIO_WHATSAPP_NUMBER=whatsapp:+YOUR_APPROVED_SENDER
TWILIO_CONTENT_SID=YOUR_APPROVED_HX_CONTENT_SID
TWILIO_CONTENT_VARIABLES={}
TWILIO_PUBLIC_WEBHOOK_URL=https://YOUR_TUNNEL_HOST/twilio/webhook
GROQ_API_KEY=YOUR_GROQ_API_KEY
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=6
GOOGLE_PLACES_API_KEY=YOUR_GOOGLE_PLACES_API_KEY
# Optional durable civic storage directory; omitted defaults to backend/data.
# SMART_NAGRIK_DATA_DIR=C:/path/to/private/smart-nagrik-data
